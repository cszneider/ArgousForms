{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "tests/**/*.js",
    "*.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
